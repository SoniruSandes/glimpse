// Windows resources embedded by build.rs: the EXE icon and the version info shown in Task Manager.
1 ICON "icons/app.ico"

1 VERSIONINFO
FILEVERSION 0,7,0,0
PRODUCTVERSION 0,7,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Quick Look"
      VALUE "ProductName", "quicklook-rs"
      VALUE "OriginalFilename", "quicklook.exe"
      VALUE "FileVersion", "0.7.0"
      VALUE "ProductVersion", "0.7.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
